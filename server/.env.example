# Database
DATABASE_URL=postgresql://user:password@localhost:5432/instagram_clone

# JWT secrets
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret

# Server
NODE_ENV=development
PORT=3001

# Client URL (for CORS in production)
CLIENT_URL=http://localhost:5173

# File uploads: Server uses local disk storage (multer).
# For production on ephemeral hosts, migrate to cloud storage (S3/Cloudinary).
